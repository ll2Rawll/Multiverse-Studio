{
  "name": "multiverse-studio",
  "productName": "Multiverse Studio",
  "version": "0.2.0",
  "description": "Explore different directions. Keep what works.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "Multiverse Studio",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:harness": "node scripts/harness.mjs --build-only && node e2e/harness-journey.mjs",
    "bench": "node --import tsx scripts/bench.ts",
    "harness": "node scripts/harness.mjs",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:dir": "npm run build && electron-builder --dir --config electron-builder.yml",
    "bundle:ffmpeg": "node scripts/bundle-ffmpeg.mjs",
    "sample:fonts": "python3 scripts/build-sample-fonts.py /usr/share/fonts sample/shared/fonts"
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "diff": "^8.0.2",
    "jszip": "^3.10.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "monaco-editor": "^0.52.2",
    "playwright": "^1.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "zustand": "^5.0.4"
  }
}
